+    if (!launcher_model_language_available(m, m->s.language_index, NULL, 0)) {
+        m->s.language_index = 0;
+        launcher_model_apply_ui_language(m);
+    }
+}
+
+/* Why the next language is not selectable, for the row under the selector;
+ * empty when every language is available. */
+void launcher_model_language_status(const LauncherModel* m, char* out, size_t out_size) {
+    if (!out || !out_size) return;
+    out[0] = '\0';
+    for (int i = 1; i < m->num_languages; ++i)
+        if (launcher_model_language_available(m, i, out, out_size) == 0 && out[0]) return;
+    out[0] = '\0';
