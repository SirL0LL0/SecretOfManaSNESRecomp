+    /* Skip the entries the player cannot use yet (a translation whose patch
+     * is missing); the first language is always there. */
+    int idx = m->s.language_index;
+    for (int step = 0; step < m->num_languages; ++step) {
+        idx = (idx + 1) % m->num_languages;
+        if (launcher_model_language_available(m, idx, NULL, 0)) break;
+    }
+    m->s.language_index = idx;
+    launcher_model_apply_ui_language(m);
+}
+
+void launcher_model_set_language_file(LauncherModel* m, const char* path) {
