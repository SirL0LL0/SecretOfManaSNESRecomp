+
+void launcher_model_apply_ui_language(const LauncherModel* m) {
+    if (m->num_languages <= 0 || !m->language_ui_codes) return;
+    int idx = clampi(m->s.language_index, 0, m->num_languages - 1);
+    if (m->language_ui_codes[idx]) recomp_launcher_set_ui_language(m->language_ui_codes[idx]);
